        <mxCell id="node_pass2" value="&lt;b style=&quot;font-size: 12px; color: #38bdf8;&quot;&gt;PASS 2: UNMASKED CoT&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;Tên nhân khẩu học gốc&lt;br&gt;+ ASYMMETRIC_UNMASKED&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #fde68a;&quot;&gt;&amp;rarr; P_unmasked, R_unmasked&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0284c7;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="420" width="220" height="110" as="geometry" />
