        <mxCell id="hdr_s4a" value="&lt;b style=&quot;color: #34d399; font-size: 12px;&quot;&gt;4A. FAST PATH (80.9% MẪU)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
