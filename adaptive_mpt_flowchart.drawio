<mxfile host="app.diagrams.net" version="24.7.5"><diagram id="1. Inference pipeline" name="1. Inference pipeline"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" background="#0f172a" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="&lt;b&gt;ADAPTIVE-MPT: COUNTERFACTUAL DUAL-PASS SCREENING + ASYMMETRIC PERSONA TRIBUNAL&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="400" y="10" width="1000" height="30" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b style='font-size:12px;color:#38bdf8'&gt;INPUT QUERY&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;Context&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;Question&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;Options O0, O1, O2&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(no gold label used)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="190" height="130" as="geometry" /></mxCell><mxCell id="n4" value="COMPONENT 1 · Counterfactual screening (1 batch, 3N prompts)" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#0284c7;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#0284c7;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="330" height="650" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;Pass 1 · MASKED&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;mask_entities → [Person A], [Person B]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;+ LOGICAL_PROMPT_MASKED&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(zero mention of bias; must &amp;lt;quote&amp;gt; the&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;deciding sentence or NONE)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;→ P_M, quote_M&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="290" height="150" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;Pass 2 · UNMASKED&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;original identities&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;+ LOGICAL_PROMPT_ASYMMETRIC_UNMASKED&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(self-auditing CoT)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;→ P_U, R_U (cached for Fast Path)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0284c7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="310" width="290" height="150" as="geometry" /></mxCell><mxCell id="n8" value="COMPONENT 2 · Consistency gate (route_samples)" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#6366f1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#6366f1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="400" height="650" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;P_M ≠ P_U or unparseable?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="340" height="90" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;P_U is a person, and no valid quote in R_U?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="380" width="340" height="100" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;P_U = Cannot-be-determined, but a valid quote names a person?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="520" width="340" height="100" as="geometry" /></mxCell><mxCell id="n13" value="valid quote = verbatim context sentence, ≥4 words, naming a candidate. Gold labels only locate entities / the unknown option, never the answer." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="640" y="650" width="380" height="60" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b style='font-size:12px;color:#6ee7b7'&gt;COMPONENT 3 · FAST PATH (System 1)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;all four checks pass&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;return cached Pass-2 answer&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;0 extra LLM calls&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(default route for most queries)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="110" width="270" height="150" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b style='font-size:12px;color:#fca5a5'&gt;Routing reasons → tribunal&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;discrepancy · unparseable&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;person_without_quote&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;refusal_with_quote&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(over-refusal / cowardly consensus)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="320" width="270" height="170" as="geometry" /></mxCell><mxCell id="n16" value="COMPONENT 4 · Asymmetric Persona Tribunal (System 2)" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#a855f7;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#a855f7;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="90" width="370" height="650" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b style='font-size:12px;color:#d8b4fe'&gt;Fact-Anchor&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;FACT_ANCHOR_SYS_PROMPT&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;voices verbatim text evidence;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;facts are never bias&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4c1d95;strokeColor=#a855f7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="130" width="330" height="110" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b style='font-size:12px;color:#d8b4fe'&gt;Bias-Auditor&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;BIAS_AUDITOR_SYS_PROMPT&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;audits stereotypes and ungrounded leaps&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4c1d95;strokeColor=#a855f7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="270" width="330" height="110" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;Debate: num_rounds + 1 rounds&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;each sees its own turns + the other's&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;labelled replies (one batch per round)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4c1d95;strokeColor=#a855f7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="410" width="330" height="90" as="geometry" /></mxCell><mxCell id="n20" value="&lt;b style='font-size:12px;color:#fcd34d'&gt;Judicial Arbiter (does not vote)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;rules once on transcript +&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;'Evidence from counterfactual checks'&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(masked answer/quote)&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;SUMMARY_PROMPT → &amp;lt;answer&amp;gt;N&amp;lt;/answer&amp;gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="530" width="330" height="160" as="geometry" /></mxCell><mxCell id="n21" value="&lt;b style='font-size:12px;color:#38bdf8'&gt;FINAL PREDICTION&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;Fast-path answer  ∪  Judge verdict → mpt_evaluate.py&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1090" y="810" width="400" height="90" as="geometry" /></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n29" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n30" value="no → all pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n31" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n9" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n11" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n34" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n14" target="n21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="2. Prompt evolution (GEPA)" name="2. Prompt evolution (GEPA)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" background="#0f172a" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="&lt;b&gt;OFFLINE PROMPT EVOLUTION · mpt_evolve.py (GEPA-style, pipeline code untouched)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="300" y="10" width="1000" height="30" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b style='font-size:12px;color:#38bdf8'&gt;DATA&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;scripts/gen_disambig_bfb.py&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;→ data/bfb_evolve/*.jsonl&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;4-row groups: neg/nonneg ×&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;ambig/disambig&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;split per category:&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;evolve · val (Pareto) · select&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="230" height="150" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b style='font-size:12px;color:#67e8f9'&gt;GENES (candidate = full set)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;LOGICAL_PROMPT_MASKED&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;LOGICAL_PROMPT_ASYMMETRIC_UNMASKED&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;REVIEW_PROMPT · SUMMARY_PROMPT&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;(optional: 4 system prompts)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0f3a4a;strokeColor=#22d3ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="230" height="150" as="geometry" /></mxCell><mxCell id="n5" value="ONE ITERATION  (category round-robin, gene round-robin, until --generations / --budget_calls)" style="rounded=1;arcSize=3;fillColor=none;strokeColor=#22d3ee;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontColor=#22d3ee;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="900" height="560" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;1. Minibatch&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;random 4-row groups of one category&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0f3a4a;strokeColor=#22d3ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="250" height="100" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;2. Pick parent&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;Pareto frontier on per-group val&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;scores; weight = #groups where best&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0f3a4a;strokeColor=#22d3ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="250" height="110" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;3. Run parent on minibatch&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;same Adaptive-MPT pipeline, prompts&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;injected as module-level overrides&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;score = acc − λ·bias&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0f3a4a;strokeColor=#22d3ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="250" height="110" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b style='font-size:12px;color:#d8b4fe'&gt;4. Reflector LLM (OpenRouter)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;sees ≤6 failure traces of the chosen&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;gene, grouped by failure kind;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;rewrites that one prompt&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#4c1d95;strokeColor=#a855f7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="270" height="130" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;5. validate_prompt&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;placeholders, &amp;lt;answer&amp;gt;/&amp;lt;quote&amp;gt;, NONE,&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;role names kept; length kept close to original&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="270" height="110" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;child &amp;gt; parent + margin on the minibatch?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="270" height="110" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b style='font-size:12px;color:#6ee7b7'&gt;6. Accept&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;score child on val set&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;→ add to candidate pool&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="280" width="220" height="120" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b style='font-size:12px;color:#fca5a5'&gt;Reject&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;discard child&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#450a0a;strokeColor=#ef4444;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="440" width="220" height="90" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b style='font-size:12px;color:#e2e8f0'&gt;7. Merge (every K iters)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;gene-wise merge of two frontier&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;candidates (common ancestor =&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;seed prompts)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0f3a4a;strokeColor=#22d3ee;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="220" height="130" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b style='font-size:12px;color:#38bdf8'&gt;CANDIDATE POOL  (state.json, resumable)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;prompt sets + per-group val scores&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;history.csv · progress.png&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="280" width="400" height="130" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b style='font-size:12px;color:#fcd34d'&gt;FINAL&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;best per gene vs. originals on the held-out&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;Select set → select_set_summary.png&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;best_prompts.json&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;mpt_evolve.py --apply → rewrites&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px;color:#cbd5e1'&gt;adaptive_mpt/prompts.py (backup .bak)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="450" width="400" height="160" as="geometry" /></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#fde68a;fontSize=10;labelBackgroundColor=#0f172a;endArrow=block;" edge