<mxfile host="app.diagrams.net" modified="2026-09-19T05:35:00.000Z" agent="Mozilla/5.0" version="24.7.5">
  <diagram id="adaptive_mpt_clean" name="Adaptive-MPT Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 20px; letter-spacing: 1px; color: #f8fafc;&quot;&gt;ADAPTIVE-MPT (ADAPTIVE MULTI-PERSONA THINKING) ARCHITECTURE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="25" width="850" height="40" as="geometry" />
        </mxCell>

        <!-- STAGE 1: INPUT QUERY -->
        <mxCell id="hdr_s1" value="&lt;b style=&quot;color: #94a3b8; font-size: 12px;&quot;&gt;INPUT QUERY&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="node_input" value="&lt;b style=&quot;font-size: 13px; color: #ffffff;&quot;&gt;INPUT QUERY&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;• Context Text&lt;br&gt;• Question&lt;br&gt;• Options: O_0, O_1, O_2&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #38bdf8;&quot;&gt;100% Zero-Oracle&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- STAGE 2: DUAL-PASS SCREENING -->
        <mxCell id="hdr_s2" value="&lt;b style=&quot;color: #94a3b8; font-size: 12px;&quot;&gt;DUAL-PASS SCREENING (BATCH 2N)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="110" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="node_pass1" value="&lt;b style=&quot;font-size: 12px; color: #38bdf8;&quot;&gt;PASS 1: MASKED ENTITY&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border-color: #334155;&quot;&gt;&lt;font style=&quot;font-size: 11px; color: #cbd5e1;&quot;&gt;[Person A], [Person B] in context&lt;br&gt;+ LOGICAL_PROMPT_MASKED&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #fde68a;&quot;&gt;&amp;rarr; P_masked&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0284c7;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="140" width="220" height="110" as="geometry" />
